# Copy to .env and fill in what you need. Every value here is a placeholder —
# never commit real credentials. Anything left blank falls back to the default in
# config.py, and the app starts without any of the optional keys.

# ── LLM (required for planning features) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=openai/gpt-oss-20b
# Optional second provider, used when Groq fails.
OPENROUTER_API_KEY=

# ── Web search (optional; enables live prices and attraction lookups) ─────────
SERPER_API_KEY=
EXA_API_KEY=
RAPIDAPI_KEY=

# ── Accounts ──────────────────────────────────────────────────────────────────
# Postgres in production: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./tripplanner.db
# REQUIRED in production. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving the default means anyone can mint tokens for any account.
JWT_SECRET=
# Assigns the reserved handle to this address on first boot; blank disables seeding.
SEED_USERNAME_EMAIL=

# ── Outgoing email (password reset + address verification) ────────────────────
# With SMTP_HOST blank, no mail is sent: links are logged instead, and only when
# DEBUG=true. Port 587 uses STARTTLS, 465 implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# Public origin of the frontend — every emailed link is built from this.
APP_BASE_URL=http://localhost:3000

# ── Infrastructure (optional) ────────────────────────────────────────────────
# Shared cache and rate-limit store; falls back to in-process memory.
# Without it each worker enforces its own quota and limits reset on every deploy.
REDIS_URL=
SENTRY_DSN_BACKEND=
# Comma-separated extra CORS origins; localhost:3000 is always allowed.
# Set this to your deployed frontend origin — the API is not open to all sites.
ALLOWED_ORIGINS=
# Set to "production" on the deployed instance. Startup then refuses to run with
# a default or too-short JWT_SECRET, or with DEBUG on, instead of only warning.
ENVIRONMENT=development
# Enable only when a reverse proxy (Render, nginx, Cloudflare) sets
# X-Forwarded-For. Off means rate limits key on the proxy IP; on without a proxy
# means callers can spoof the header and bypass throttling entirely.
TRUST_PROXY_HEADERS=false
# "json" emits one object per line so a log platform can filter on fields like
# status, route and duration_ms. "text" is easier to read in a local terminal.
LOG_FORMAT=json
# Verbose logging. Never enable in production: it logs emailed reset links.
DEBUG=false
