# Public API origin. Leave blank for same-origin deployments.
NEXT_PUBLIC_API_URL=http://localhost:8000

# hCaptcha browser site key. Set this whenever the backend has
# HCAPTCHA_SECRET_KEY configured; both values must come from the same hCaptcha site.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Optional monitoring and analytics.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=